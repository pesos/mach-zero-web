# The eventKit API (eventkit-serverless or eventkit-api). Locally: /api (proxied to :4000).
VITE_EVENTKIT_API_URL=/api
# Your event's id and API key (eventKit console → your event → Portal & settings).
# The key is visible in the bundle by design: it says which event's portal is calling and grants nothing.
VITE_EVENTKIT_EVENT_ID=
VITE_EVENTKIT_API_KEY=
# The registration link teams use (console → Links → a registration link's URL).
# Without it, the homepage hides its Register buttons.
VITE_REGISTER_URL=
